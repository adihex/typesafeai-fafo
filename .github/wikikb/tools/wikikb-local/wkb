#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIST="$SCRIPT_DIR/dist/main.js"

if [ ! -f "$DIST" ]; then
  echo "ERROR: WikiKB TypeScript CLI is not built." >&2
  echo "Run: npm install && npm run build:wkb" >&2
  exit 1
fi

exec node "$DIST" "$@"
